{
  "compilerOptions": {
    // File Layout
    "rootDir": "./",

    "outDir": "./dist",

    // Environment Settings (FIX UTAMA)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node", "jest"],

    // Output
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    

    // Type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Module behavior
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    // Optional (aman)
    "skipLibCheck": true
  }
}